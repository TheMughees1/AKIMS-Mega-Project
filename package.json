{
  "name": "akims-campus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node --env-file-if-exists=.env.local scripts/build.mjs",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:start": "node --env-file-if-exists=.env.local scripts/database.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "test": "node --env-file-if-exists=.env.local scripts/test.mjs",
    "setup": "bash scripts/setup.sh",
    "local:start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "account:provision": "node --env-file-if-exists=.env.local scripts/provision-account.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/dm-serif-display": "^5.2.8",
    "lucide-react": "^0.468.0",
    "next": "16.4.4",
    "pdf-lib": "^1.17.1",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "18.6.0-beta.19",
    "typescript": "^5.9.3"
  }
}
